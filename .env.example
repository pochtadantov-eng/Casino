# Telegram bot token from @BotFather (leave empty to run API only)
BOT_TOKEN=
# Public HTTPS URL where the Mini App is served (set the same URL in @BotFather -> Mini App)
WEBAPP_URL=https://example.com
DATABASE_URL=postgres://casino:casino@localhost:5432/casino
PORT=3000
# Limits, in Stars
MIN_BET=50
MAX_BET=100000
MAX_PAYOUT=1000000
MIN_DEPOSIT=50
MAX_DEPOSIT=10000
MIN_WITHDRAW=100
# Comma separated Telegram user ids allowed to use /pending /approve /reject
ADMIN_IDS=
# 1 = accept "x-dev-user: <id>" header instead of Telegram initData. NEVER in production.
DEV_AUTH=0
# Withdrawing as a Telegram gift (the bot pays it from ITS Stars balance, so keep the bot funded): fee on top of the gift price, per-player limit
GIFT_FEE_PCT=10
GIFTS_PER_DAY=5
# Daily chest (roulette of Stars / Telegram gifts, prizes and odds in src/wallet/chest.ts): 1 = on, 0 = off
DAILY_BONUS=10
# 1 = anybody can open the daily chest without the 24 h wait (TESTING ONLY - free Stars!). ADMIN_IDS can always do it.
CHEST_UNLIMITED=0

# derives the shared Rocket crash points - set a long random value in production
ROCKET_SECRET=change-me-to-a-long-random-string
